<Window x:Class="JL_Monitor_Brightness.BrightnessOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JL_Monitor_Brightness"
        mc:Ignorable="d"
        Title="Brightness Control"
        Height="120" Width="368"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource UiFont}"
        MouseWheel="Overlay_MouseWheel">

    <!--
      Пилюля 320×52 вместо прежнего чёрного прямоугольника 440×120: площадь меньше
      втрое. Радиус ровно в половину высоты — только так скругление читается,
      прежние 10 при высоте 120 выглядели прямыми углами.

      Настоящего размытия за окном не будет: AllowsTransparency исключает
      DWM-backdrop, а системный акрил красит весь прямоугольник окна и вылезает
      из-под скруглений. Поэтому стекло имитируется плотной заливкой с hairline —
      на 52 пикселях высоты этого достаточно, текст читается на любых обоях.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Pill" Grid.Row="0"
                Width="320" Height="52"
                CornerRadius="{StaticResource RPill}"
                Background="{DynamicResource GlassSolid}"
                BorderBrush="{DynamicResource Hairline}"
                BorderThickness="1"
                Effect="{StaticResource Shadow3}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PillSlide" Y="8"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Margin="14,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="18" Height="18"
                      Data="{StaticResource IconSun}"
                      Stroke="{DynamicResource Ink2}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform" VerticalAlignment="Center"/>

                <!-- Двойной клик возвращает 100%: то же движение, что и в настройках,
                     где двойным кликом сбрасывается любой ползунок. -->
                <Slider x:Name="BrightnessSlider"
                        Grid.Column="1"
                        Margin="12,0"
                        Minimum="0" Maximum="100" Value="50"
                        Style="{StaticResource HaloSlider}"
                        MouseDoubleClick="BrightnessSlider_ResetToFull"
                        ValueChanged="BrightnessSlider_ValueChanged"/>

                <!-- Ширина фиксирована и цифры табличные: иначе число прыгает
                     при переходе 9% → 10% → 100% и дёргает весь ряд. -->
                <TextBlock x:Name="BrightnessTextBlock"
                           Grid.Column="2"
                           Width="38" TextAlignment="Right"
                           Text="50%"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Имя монитора под пилюлей, а не в общей строке: в ряду оно съедало
             место и спорило с числом за внимание. Скрывается, когда монитор один. -->
        <TextBlock x:Name="MonitorNameTextBlock"
                   Grid.Row="1"
                   Text="Monitor 1"
                   FontSize="11"
                   Foreground="{DynamicResource Ink4}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>
