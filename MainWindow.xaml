<Window x:Class="JL_Monitor_Brightness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JL_Monitor_Brightness"
        mc:Ignorable="d"
        Title="JL Monitor Brightness"
        Height="560" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource UiFont}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Строка настройки: подпись слева, контрол справа, разделитель снизу.
             Высота 44 вместо прежних ~28 — мелкий текст в тесной сетке читался хуже всего. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Height" Value="44"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Заголовок раздела: мелкий и приглушённый НАД карточкой.
             Раньше был 16px SemiBold чёрным — читался как заголовок в текстовом редакторе. -->
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,4,16,4"/>
            <Setter Property="Effect" Value="{StaticResource Shadow1}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Hairline}"/>
        </Style>
    </Window.Resources>

    <!-- Скругление окна рисуем сами: WindowStyle=None убирает системную рамку -->
    <Border CornerRadius="14" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.98" ScaleY="0.98"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Свой заголовок окна ─────────────────────────────────────── -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="17" Height="17" Margin="18,0,0,0"
                      Data="{StaticResource IconSun}"
                      Stroke="{DynamicResource Ink2}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Яркость" Margin="10,0,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Width="40" Height="44" Click="Minimize_Click"
                        Style="{StaticResource ClearButton}" ToolTip="Свернуть">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource Ink2}"
                                      StrokeThickness="1.2" VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3" Width="46" Height="44" Click="CloseWindow_Click" ToolTip="Закрыть">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="0,13,0,0">
                                <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource Ink2}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E5484D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── Вкладки ─────────────────────────────────────────────────── -->
            <TabControl x:Name="Tabs" Grid.Row="1" Margin="24,0,24,0"
                        Style="{StaticResource SegmentTabs}"
                        ItemContainerStyle="{StaticResource SegmentTabItem}"
                        SelectionChanged="Tabs_SelectionChanged">

                <!-- ═══ Общие ═══ -->
                <TabItem Header="Общие">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Запуск" Style="{StaticResource GroupCaption}"/>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Запускать при старте Windows" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                                  Style="{StaticResource Toggle}"
                                                  HorizontalAlignment="Right"
                                                  Checked="StartWithWindowsCheckBox_Changed"
                                                  Unchecked="StartWithWindowsCheckBox_Changed"/>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Сворачивать в трей при закрытии" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="MinimizeToTrayCheckBox"
                                                  Style="{StaticResource Toggle}"
                                                  HorizontalAlignment="Right"
                                                  Checked="MinimizeToTrayCheckBox_Changed"
                                                  Unchecked="MinimizeToTrayCheckBox_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Мониторы" Style="{StaticResource GroupCaption}"/>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Монитор по умолчанию" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="DefaultMonitorComboBox"
                                                  Style="{StaticResource HaloCombo}"
                                                  Width="240" HorizontalAlignment="Right"
                                                  SelectionChanged="DefaultMonitorComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Шаг изменения яркости" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Slider x:Name="BrightnessStepSlider" Width="160"
                                                    Style="{StaticResource HaloSlider}"
                                                    Minimum="1" Maximum="20" Value="10"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="BrightnessStepSlider_ValueChanged"/>
                                            <TextBlock x:Name="BrightnessStepTextBlock" Text="10%"
                                                       Width="42" TextAlignment="Right" Margin="12,0,0,0"
                                                       Style="{StaticResource RowValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="RefreshMonitorsButton"
                                    Content="Обновить список мониторов"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Click="RefreshMonitorsButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ Горячие клавиши ═══ -->
                <TabItem Header="Клавиши">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Нажмите на поле и задайте комбинацию" Style="{StaticResource GroupCaption}"/>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Увеличить яркость" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox x:Name="BrightnessUpHotkeyTextBox" Width="170"
                                                     Style="{StaticResource HotkeyBox}"
                                                     KeyDown="HotkeyTextBox_KeyDown"/>
                                            <Button x:Name="ClearBrightnessUpButton" Margin="6,0,0,0"
                                                    Style="{StaticResource ClearButton}"
                                                    Click="ClearHotkeyButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Уменьшить яркость" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox x:Name="BrightnessDownHotkeyTextBox" Width="170"
                                                     Style="{StaticResource HotkeyBox}"
                                                     KeyDown="HotkeyTextBox_KeyDown"/>
                                            <Button x:Name="ClearBrightnessDownButton" Margin="6,0,0,0"
                                                    Style="{StaticResource ClearButton}"
                                                    Click="ClearHotkeyButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Показать регулятор" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox x:Name="BrightnessOverlayHotkeyTextBox" Width="170"
                                                     Style="{StaticResource HotkeyBox}"
                                                     KeyDown="HotkeyTextBox_KeyDown"/>
                                            <Button x:Name="ClearBrightnessOverlayButton" Margin="6,0,0,0"
                                                    Style="{StaticResource ClearButton}"
                                                    Click="ClearHotkeyButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Ink4}"
                                       Margin="4,0,4,0"
                                       Text="Комбинация должна содержать хотя бы один модификатор: Ctrl, Alt, Shift или Win. Клавиши не сработают, если активное окно запущено от имени администратора."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ Внешний вид ═══ -->
                <TabItem Header="Вид">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Регулятор яркости" Style="{StaticResource GroupCaption}"/>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Прозрачность" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Slider x:Name="OpacitySlider" Width="160"
                                                    Style="{StaticResource HaloSlider}"
                                                    Minimum="0.3" Maximum="1" Value="0.9"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="OpacitySlider_ValueChanged"/>
                                            <TextBlock x:Name="OpacityTextBlock" Text="90%"
                                                       Width="42" TextAlignment="Right" Margin="12,0,0,0"
                                                       Style="{StaticResource RowValue}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Время отображения" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Slider x:Name="TimeoutSlider" Width="160"
                                                    Style="{StaticResource HaloSlider}"
                                                    Minimum="800" Maximum="6000" Value="1400"
                                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="TimeoutSlider_ValueChanged"/>
                                            <TextBlock x:Name="TimeoutTextBlock" Text="1,4 с"
                                                       Width="42" TextAlignment="Right" Margin="12,0,0,0"
                                                       Style="{StaticResource RowValue}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Показывать проценты" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="ShowPercentageCheckBox"
                                                  Style="{StaticResource Toggle}"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Цвет акцента" Style="{StaticResource RowLabel}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border x:Name="ColorPreviewBorder" Width="22" Height="22"
                                                    CornerRadius="11" Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                                <Rectangle x:Name="ColorPreviewRectangle" RadiusX="10" RadiusY="10"/>
                                            </Border>
                                            <ComboBox x:Name="ThemeColorComboBox" Width="180"
                                                      Style="{StaticResource HaloCombo}"
                                                      SelectionChanged="ThemeColorComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Лаванда" Tag="#7C82F4"/>
                                                <ComboBoxItem Content="Небо" Tag="#5AA9E6"/>
                                                <ComboBoxItem Content="Мята" Tag="#3FBF9F"/>
                                                <ComboBoxItem Content="Песок" Tag="#E0A34A"/>
                                                <ComboBoxItem Content="Коралл" Tag="#E0697A"/>
                                                <ComboBoxItem Content="Графит" Tag="#6B6B75"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ О программе ═══ -->
                <TabItem Header="О программе">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="JL Monitor Brightness"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}"/>
                                    <TextBlock x:Name="VersionTextBlock" Text="Версия 1.1.0"
                                               FontSize="12.5" Foreground="{DynamicResource Ink4}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                               Foreground="{DynamicResource Ink2}" Margin="0,14,0,0"
                                               Text="Яркость внешних мониторов с клавиатуры. Работает через DDC/CI — тот же канал, которым пользуется экранное меню самого монитора."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Обновления" Style="{StaticResource GroupCaption}"/>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Проверять при запуске" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="CheckForUpdatesCheckBox"
                                                  Style="{StaticResource Toggle}"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Проверить сейчас" Style="{StaticResource RowLabel}"/>
                                        <Button x:Name="CheckForUpdatesButton" Content="Проверить"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Right"
                                                Click="CheckForUpdatesButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ── Низ окна ────────────────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="24,10,24,20">
                <Button x:Name="CancelButton" Content="Отмена"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Сохранить"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
