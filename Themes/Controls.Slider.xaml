<!--
  Слайдер яркости. Раньше был дефолтный Aero2: треугольный «флажок» на треке в
  4 пикселя — контрол из 2006 года.

  IsMoveToPointEnabled=True даёт поведение как в мобильных системах: тап по любой
  точке трека сразу ставит значение, а не листает по странице.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="HaloSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center" Height="18" Background="Transparent">

            <Border Height="6" CornerRadius="3"
                    Background="{DynamicResource TrackBg}"
                    VerticalAlignment="Center"/>

            <Track x:Name="PART_Track">
              <!--
                ⛔ Заполненная часть живёт ВНУТРИ DecreaseRepeatButton, а не рядом
                с треком. Отдельный Border с HorizontalAlignment="Left" ширину
                ниоткуда не получает — она остаётся нулевой, и полоса всегда серая
                при любом значении. Так и было до 25.08.2026, пока не заметили.
                Кнопка уменьшения занимает ровно ту часть трека, что слева от
                бегунка, — её и красим.
              -->
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                              Background="Transparent">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBrush}"/>
                      </Grid>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb" Width="16" Height="16" Focusable="False"
                       RenderTransformOrigin="0.5,0.5">
                  <Thumb.RenderTransform>
                    <ScaleTransform/>
                  </Thumb.RenderTransform>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid RenderTransformOrigin="0.5,0.5">
                        <!--
                          ⛔ Увеличение при наведении делается масштабом, а не шириной.
                          Ширина бегунка участвует в раскладке трека: Track вычитает её
                          из доступного места, и заполненная часть заметно дёргалась
                          влево, стоило подвести мышь. Замечено 25.08.2026.
                        -->
                        <Ellipse Width="16" Height="16" Fill="White"
                                 Stroke="{DynamicResource HairlineStrong}" StrokeThickness="1">
                          <Ellipse.Effect>
                            <DropShadowEffect Color="#141626" BlurRadius="8" ShadowDepth="1"
                                              Direction="270" Opacity="0.18"/>
                          </Ellipse.Effect>
                        </Ellipse>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Thumb.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1.14" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Thumb.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1.14" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Thumb.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Thumb.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
