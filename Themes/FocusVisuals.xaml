<!--
  ⛔ Пунктирная рамка фокуса Windows.

  Alt переводит окно в режим клавиатурной навигации, и WPF рисует свой пунктир
  вокруг элемента, у которого сейчас фокус, — поверх любых наших стилей. То же
  происходит после Escape, снятия скриншота, обхода табом. Выглядит инородно:
  собственные состояния наведения и нажатия у контролов уже есть.

  У наших именованных стилей FocusVisualStyle отключён внутри самих стилей.
  Здесь — страховка для контролов БЕЗ явного стиля: неявный стиль до них
  дотягивается, а до оформленных нет (явный стиль всегда сильнее неявного).

  Замечено при проверке 25.08.2026: пунктир обводил и отдельную кнопку, и целую
  область вкладки, смотря куда нажимали последний раз.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style TargetType="Button">      <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="RepeatButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="CheckBox">    <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="RadioButton"> <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TextBox">     <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ComboBox">    <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ListBox">     <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ListBoxItem"> <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Slider">      <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TabControl">  <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TabItem">     <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ScrollViewer"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ScrollBar">   <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Expander">    <Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>

</ResourceDictionary>
