<!--
  Иконки как PathGeometry: ноль зависимостей, красятся токенами, масштабируются
  без мыла. Рисунок в духе Lucide (ISC).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

  <!-- Солнце: круг и восемь лучей -->
  <GeometryGroup x:Key="IconSun" po:Freeze="True">
    <EllipseGeometry Center="12,12" RadiusX="4.2" RadiusY="4.2"/>
    <LineGeometry StartPoint="12,1.6"  EndPoint="12,4.2"/>
    <LineGeometry StartPoint="12,19.8" EndPoint="12,22.4"/>
    <LineGeometry StartPoint="1.6,12"  EndPoint="4.2,12"/>
    <LineGeometry StartPoint="19.8,12" EndPoint="22.4,12"/>
    <LineGeometry StartPoint="4.6,4.6"   EndPoint="6.5,6.5"/>
    <LineGeometry StartPoint="17.5,17.5" EndPoint="19.4,19.4"/>
    <LineGeometry StartPoint="4.6,19.4"  EndPoint="6.5,17.5"/>
    <LineGeometry StartPoint="17.5,6.5"  EndPoint="19.4,4.6"/>
  </GeometryGroup>

  <!-- Монитор -->
  <GeometryGroup x:Key="IconMonitor" po:Freeze="True">
    <RectangleGeometry Rect="2,3.5,20,13" RadiusX="2" RadiusY="2"/>
    <LineGeometry StartPoint="8,20.5" EndPoint="16,20.5"/>
    <LineGeometry StartPoint="12,16.5" EndPoint="12,20.5"/>
  </GeometryGroup>

</ResourceDictionary>
